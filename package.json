{
  "name": "microbit-shooter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "«Защитник Неба» — HTML5 16-bit shooter, порт игры с BBC micro:bit",
  "scripts": {
    "dev": "node server.mjs",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "vitest": "^3.2.7"
  }
}
